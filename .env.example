# Copy to `.env` for local use, and set the same keys in your host's dashboard
# for production. `.env` is gitignored; this example file is committed.
#
# Every key below is optional. With none set the site still builds and deploys —
# it simply omits absolute SEO URLs and hides the unconfigured social links and
# map embed rather than pointing at guessed values (see .planning/DESIGN-AUDIT.md
# items H8 and L12).

# --- Site origin -----------------------------------------------------------------
# Absolute origin, no trailing slash. Used for canonical URLs, hreflang
# alternates, og:url / og:image, /sitemap.xml and the Sitemap line in /robots.txt.
# On Netlify this is filled automatically from the injected `URL` variable;
# set it explicitly on any other host.
# NUXT_PUBLIC_SITE_URL=https://www.kinnovart.com

# Legacy alias, still honoured by nuxt.config.ts as a fallback.
# NUXT_PUBLIC_I18N_BASE_URL=https://www.kinnovart.com

# --- Contact ---------------------------------------------------------------------
# NUXT_PUBLIC_CONTACT_EMAIL=contact@kinnovart.com
# International format, digits only (used for wa.me links and JSON-LD telephone).
# NUXT_PUBLIC_WHATSAPP=224611464609

# --- Social profiles -------------------------------------------------------------
# Any network left empty is hidden from the footer and excluded from the
# schema.org `sameAs` list, so no dead link can ship.
# NUXT_PUBLIC_SOCIAL_FACEBOOK=https://www.facebook.com/KAALAPROD
# NUXT_PUBLIC_SOCIAL_INSTAGRAM=
# NUXT_PUBLIC_SOCIAL_TIKTOK=
# NUXT_PUBLIC_SOCIAL_YOUTUBE=
# NUXT_PUBLIC_SOCIAL_LINKEDIN=

# --- Location map ----------------------------------------------------------------
# Set NUXT_PUBLIC_MAP_EMBED_URL to an empty string to hide the map entirely.
# NUXT_PUBLIC_MAP_EMBED_URL=https://www.openstreetmap.org/export/embed.html?bbox=-13.5984%2C9.6312%2C-13.5584%2C9.6512&layer=mapnik&marker=9.6412%2C-13.5784
# NUXT_PUBLIC_MAP_LINK_URL=https://www.openstreetmap.org/?mlat=9.6412&mlon=-13.5784#map=17/9.6412/-13.5784
# NUXT_PUBLIC_MAP_LABEL=Kinnov'art, Nongo, Conakry
